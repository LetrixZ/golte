{
  "name": "golte",
  "version": "0.1.2",
  "description": "Render Svelte components in your Go http handlers.",
  "repository": "github:nichady/golte",
  "keywords": [
    "svelte",
    "go",
    "golang"
  ],
  "author": "nichady",
  "license": "MIT",
  "homepage": "https://github.com/nichady/golte#README.md",
  "type": "module",
  "bin": {
    "golte": "js/cli/cli.js"
  },
  "dependencies": {
    "@rollup/plugin-replace": "^6.0.2",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "deepmerge": "^4.3.1",
    "esbuild": "^0.25.1",
    "fast-glob": "^3.3.2",
    "vite": "^6.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "svelte": "^5.23.1"
  },
  "files": [
    "js",
    "ts"
  ],
  "exports": {
    ".": {
      "types": "./ts/public/index.ts",
      "import": "./js/public/index.js"
    },
    "./*": {
      "types": "./ts/public/*/index.ts",
      "import": "./js/public/*/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "index": [
        "./ts/public/index.ts"
      ],
      "*": [
        "./ts/public/*/index.ts"
      ]
    }
  },
  "scripts": {
    "test": "npm run build:testdata && go test ./...",
    "build:testdata": "npm run build:js && cd testdata && node ../js/cli/cli.js && go clean -testcache",
    "build:js": "rm -rf js && tsc && node scripts/copy-svelte.js"
  }
}
